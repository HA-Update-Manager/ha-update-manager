{
    "entity": {
        "sensor": {
            "ready": {
                "default": "mdi:update"
            },
            "waiting": {
                "default": "mdi:timer-sand"
            },
            "blocked": {
                "default": "mdi:shield-alert-outline"
            },
            "skipped": {
                "default": "mdi:skip-next-outline"
            },
            "not_installable": {
                "default": "mdi:block-helper"
            },
            "needs_manual_action": {
                "default": "mdi:hand-back-right-outline"
            },
            "pending_installs": {
                "default": "mdi:timer-sand"
            },
            "failed_installs": {
                "default": "mdi:alert-circle-outline"
            }
        },
        "switch": {
            "enabled": {
                "default": "mdi:update",
                "state": {
                    "off": "mdi:update-off"
                }
            }
        }
    },
    "triggers": {
        "scheduled_auto_install": {
            "trigger": "mdi:timer-sand"
        },
        "installed": {
            "trigger": "mdi:check-circle"
        },
        "install_failed": {
            "trigger": "mdi:alert-circle-outline"
        }
    }
}
